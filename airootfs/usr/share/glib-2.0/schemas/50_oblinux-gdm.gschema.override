# OBLinux GDM/desktop branding overrides.
#
# Same mechanism Arch's own gdm package uses for the default Arch logo
# (30_org.archlinux.gdm.gschema.override) — a GSettings schema override,
# compiled by glib-compile-schemas via the pacman hook glib2 already ships
# (usr/share/libalpm/hooks/glib-compile-schemas.hook). No custom build hook
# needed; numbered higher than Arch's own override so ours wins.
#
# Note: overriding org.gnome.desktop.background changes that schema's
# *compiled default*, used by any account that hasn't set its own
# wallpaper — this is how new user accounts (e.g. created by Calamares)
# get OBLinux's own default wallpaper instead of upstream GNOME's.
#
# GDM itself no longer inherits this default as of the wallpaper set
# added below: it now has its own dconf profile/database
# (etc/dconf/profile/gdm + etc/dconf/db/gdm.d/) which takes priority for
# the gdm user specifically, giving it a distinct Ink->Slate gradient
# rather than this picture-based default. See that directory and
# docs/THEMING.md item 1 for why (a real background image on GDM's
# login screen needs fragile gresource theme-patching, not just a
# schema override).

[org.gnome.desktop.background]
picture-uri='/usr/share/backgrounds/oblinux/oblinux-soft-waves.svg'
picture-uri-dark='/usr/share/backgrounds/oblinux/oblinux-soft-waves.svg'
picture-options='zoom'
primary-color='#151a22'
color-shading-type='solid'

[org.gnome.login-screen]
logo='/usr/share/pixmaps/oblinux-logo-text-dark.svg'

# THEMING.md items 2+3: accent color and default fonts. Not overridden
# per-user by GDM's dconf profile (unlike background), so these apply
# everywhere including the GDM greeter — a deliberate, cohesive choice
# (unlike the wallpaper, there's no fragility/gresource concern here,
# it's schema keys the same way accent-color/fonts always work).
#
# accent-color: enum verified verbatim against gsettings-desktop-schemas
# upstream source (org.gnome.desktop.interface accent-color) — valid
# values are blue/teal/green/yellow/orange/red/pink/purple/slate;
# 'orange' is the closest preset to Amber (#d68a3c).
#
# font-name / document-font-name: Inter (inter-font package, added to
# packages.x86_64), registered family confirmed via the package's own
# file list (usr/share/fonts/inter/Inter.ttc — the static family used
# here rather than the variable "Inter Variable" instance).
#
# monospace-font-name: JetBrains Mono, Nerd Font-patched
# (ttf-jetbrains-mono-nerd, added to packages.x86_64) — needed for
# starship/eza's icon glyphs to render instead of missing-glyph boxes.
# Uses the "Mono" build variant specifically (not the plain or "Propo"
# variant) so icon glyphs occupy a single fixed-width cell and don't
# break terminal column alignment. Exact registered family string is
# best-confidence from Nerd Fonts' standard naming convention, not
# confirmed from the package file list alone (font names live in the
# file's internal metadata) — verify with `fc-list | grep -i
# jetbrains` after the next build and correct this value if it differs.
[org.gnome.desktop.interface]
accent-color='orange'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='JetBrainsMono Nerd Font Mono 11'
